# =============================================================================
# OpenTalib Configuration Example
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# === Supabase / Database (Required) ===

# The internal URL for the Supabase Kong gateway (default port 8000).
# Note: This URL does not need to be publicly accessible.
# It is only used by the Next.js server, not the browser.
SUPABASE_URL=http://your-ip:8000

# The Supabase Anonymous Key (from your Supabase setup).
# Note: It is only used by the Next.js server, not the browser.
SUPABASE_ANON_KEY=your-anon-key

# The Supabase Service Role Key (Required for admin tasks, keep SECRET)
SUPABASE_SERVICE_KEY=your-service-role-key

# !IMPORTANT! Direct GoTrue URL (default port 9999). 
# This MUST point directly to the auth service, NOT the Kong gateway.
# Failure to set this correctly will cause 401 Unauthorized errors on login.
SUPABASE_AUTH_URL=http://your-ip:9999

# The JWT secret used for signing tokens (must match your Supabase config)
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-chars

# === AI / LLM Provider (Required) ===

# Default model string. Format: provider:model-id (e.g., google:gemini-2.0-flash)
DEFAULT_MODEL=google:gemini-2.0-flash

# Google Gemini API Key (Required for default model)
GOOGLE_API_KEY=your-google-api-key

# OpenAI API Key (Optional, if using OpenAI models)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=

# DeepSeek API Key (Optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Qwen (Alibaba) API Key (Optional)
QWEN_API_KEY=
QWEN_BASE_URL=

# Kimi (Moonshot) API Key (Optional)
KIMI_API_KEY=
KIMI_BASE_URL=

# MiniMax API Key (Optional)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=

# GLM (Zhipu AI) API Key (Optional)
GLM_API_KEY=
GLM_BASE_URL=

# SiliconFlow API Key (Optional)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=

# Doubao (ByteDance) API Key (Optional)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=

# Grok (xAI) API Key (Optional)
GROK_API_KEY=
GROK_BASE_URL=

# Tavily API Key (Required for web search functionality)
TAVILY_API_KEY=

# === Image Generation (Required) ===

# API Key for Google Gemini Image generation (usually same as GOOGLE_API_KEY)
IMAGE_NANO_BANANA_API_KEY=your-google-api-key

# Seedream Image Generation (Optional)
IMAGE_SEEDREAM_API_KEY=
IMAGE_SEEDREAM_BASE_URL=

# Qwen Image Generation (Optional)
IMAGE_QWEN_IMAGE_API_KEY=
IMAGE_QWEN_IMAGE_BASE_URL=

# MiniMax Image Generation (Optional)
IMAGE_MINIMAX_API_KEY=
IMAGE_MINIMAX_BASE_URL=

# === Text to Speech (Required) ===

# Google Cloud TTS API Key
GOOGLE_TTS_API_KEY=your-google-tts-key

# OpenAI TTS (Optional)
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=

# Azure TTS (Optional)
TTS_AZURE_API_KEY=
TTS_AZURE_BASE_URL=

# GLM TTS (Optional)
TTS_GLM_API_KEY=
TTS_GLM_BASE_URL=

# Qwen TTS (Optional)
TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=

# MiniMax TTS (Optional)
TTS_MINIMAX_API_KEY=
TTS_MINIMAX_BASE_URL=

# ElevenLabs TTS (Optional)
TTS_ELEVENLABS_API_KEY=
TTS_ELEVENLABS_BASE_URL=

# === Local LLM / Ollama (Optional) ===

# URL for local Ollama instance (e.g., http://your-ip:11434/v1)
OLLAMA_BASE_URL=
# Comma-separated list of models available in Ollama
OLLAMA_MODELS=llama3.1,qwen2.5

# === Security ===

# Set to 'true' to allow connections to local networks (required for Ollama)
ALLOW_LOCAL_NETWORKS=false

# Allowed frame ancestors for CSP (e.g., https://your-domain.com)
ALLOWED_FRAME_ANCESTORS=

# Proxy settings (Optional)
HTTP_PROXY=
HTTPS_PROXY=

# === App Settings ===

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (text, json)
LOG_FORMAT=text

# Set to 'true' to disable LLM "thinking" animations
LLM_THINKING_DISABLED=false
